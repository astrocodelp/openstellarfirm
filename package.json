{
  "name": "openstellarfirm",
  "version": "0.1.0",
  "private": true,
  "description": "OpenStellarFirm, a desktop app for personal AI assistants that run on your own computer, on your own model. Nothing is saved in a cloud.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Vasileios Drosatos and Astro Code L.P.",
  "homepage": "https://github.com/astrocodelp/worker-bot-open-source",
  "type": "module",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "icon": "electron scripts/icon.mjs",
    "package": "pnpm build && electron-builder --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "package:mac-x64": "pnpm build && electron-builder --mac --x64 --publish never",
    "package:mac-arm64": "pnpm build && electron-builder --mac --arm64 --publish never",
    "package:win": "pnpm build && electron-builder --win --x64 --publish never",
    "package:linux": "pnpm build && electron-builder --linux --x64 --publish never",
    "ci": "bash scripts/ci.sh",
    "release:fly": "bash scripts/release/fly-run.sh",
    "release:mac": "bash scripts/release/mac.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
